<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net4.8</TargetFramework>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
    <LangVersion>8.0</LangVersion>
    <!-- Resolve Warudo Managed directory: check relative Playground path first, then common Steam paths -->
    <WarudoManagedDir Condition="'$(WarudoManagedDir)' == '' and Exists('../../../Managed/Warudo.Core.dll')">../../../Managed</WarudoManagedDir>
    <WarudoManagedDir Condition="'$(WarudoManagedDir)' == '' and Exists('E:/SteamLibrary/steamapps/common/Warudo/Warudo_Data/Managed/Warudo.Core.dll')">E:/SteamLibrary/steamapps/common/Warudo/Warudo_Data/Managed</WarudoManagedDir>
    <WarudoManagedDir Condition="'$(WarudoManagedDir)' == '' and Exists('C:/Program Files (x86)/Steam/steamapps/common/Warudo/Warudo_Data/Managed/Warudo.Core.dll')">C:/Program Files (x86)/Steam/steamapps/common/Warudo/Warudo_Data/Managed</WarudoManagedDir>
    <WarudoManagedDir Condition="'$(WarudoManagedDir)' == ''">../../../Managed</WarudoManagedDir>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="UnityEngine">
      <HintPath>$(WarudoManagedDir)/UnityEngine.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(WarudoManagedDir)/UnityEngine.CoreModule.dll</HintPath>
    </Reference>
    <Reference Include="Warudo.Core">
      <HintPath>$(WarudoManagedDir)/Warudo.Core.dll</HintPath>
    </Reference>
    <Reference Include="Warudo.Plugins.Core">
      <HintPath>$(WarudoManagedDir)/Warudo.Plugins.Core.dll</HintPath>
    </Reference>
    <Reference Include="WebSocketSharp">
      <HintPath>$(WarudoManagedDir)/websocket-sharp.dll</HintPath>
    </Reference>
    <Reference Include="UniTask">
      <HintPath>$(WarudoManagedDir)/UniTask.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.AnimationModule">
      <HintPath>$(WarudoManagedDir)/UnityEngine.AnimationModule.dll</HintPath>
    </Reference>
    <Reference Include="DOTween">
      <HintPath>$(WarudoManagedDir)/DOTween.dll</HintPath>
    </Reference>
    <Reference Include="Animancer">
      <HintPath>$(WarudoManagedDir)/Animancer.dll</HintPath>
    </Reference>
    <Reference Include="UMod">
      <HintPath>$(WarudoManagedDir)/UMod.dll</HintPath>
    </Reference>
    <Reference Include="UMod-Interface">
      <HintPath>$(WarudoManagedDir)/UMod-Interface.dll</HintPath>
    </Reference>
    <Reference Include="uDesktopDuplication.Runtime">
      <HintPath>$(WarudoManagedDir)/uDesktopDuplication.Runtime.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.XRModule">
      <HintPath>$(WarudoManagedDir)/UnityEngine.XRModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.PhysicsModule">
      <HintPath>$(WarudoManagedDir)/UnityEngine.PhysicsModule.dll</HintPath>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(WarudoManagedDir)/Newtonsoft.Json.dll</HintPath>
    </Reference>
    <Reference Include="Microsoft.CSharp" />
  </ItemGroup>
</Project>

