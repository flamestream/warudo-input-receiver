<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net4.8</TargetFramework>
    <LangVersion>8.0</LangVersion>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- Resolve Warudo Managed directory -->
    <WarudoManagedDir Condition="'$(WarudoManagedDir)' == '' and Exists('../../../Managed/Warudo.Core.dll')">../../../Managed</WarudoManagedDir>
    <WarudoManagedDir Condition="'$(WarudoManagedDir)' == '' and Exists('E:/SteamLibrary/steamapps/common/Warudo/Warudo_Data/Managed/Warudo.Core.dll')">E:/SteamLibrary/steamapps/common/Warudo/Warudo_Data/Managed</WarudoManagedDir>
    <WarudoManagedDir Condition="'$(WarudoManagedDir)' == '' and Exists('C:/Program Files (x86)/Steam/steamapps/common/Warudo/Warudo_Data/Managed/Warudo.Core.dll')">C:/Program Files (x86)/Steam/steamapps/common/Warudo/Warudo_Data/Managed</WarudoManagedDir>
    <WarudoManagedDir Condition="'$(WarudoManagedDir)' == ''">../../../Managed</WarudoManagedDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\PlaygroundPlugin.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="UnityEngine">
      <HintPath>$(WarudoManagedDir)/UnityEngine.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(WarudoManagedDir)/UnityEngine.CoreModule.dll</HintPath>
    </Reference>
    <Reference Include="Warudo.Core">
      <HintPath>$(WarudoManagedDir)/Warudo.Core.dll</HintPath>
    </Reference>
    <Reference Include="Warudo.Plugins.Core">
      <HintPath>$(WarudoManagedDir)/Warudo.Plugins.Core.dll</HintPath>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(WarudoManagedDir)/Newtonsoft.Json.dll</HintPath>
    </Reference>
    <Reference Include="Microsoft.CSharp" />
  </ItemGroup>

</Project>
